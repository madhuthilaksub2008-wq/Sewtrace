# Copy this file to .env and fill in what you need. .env is ignored by git. Never commit a key.

# Meta Model API key. Leave empty to run fully mocked (no network, no cost).
META_API_KEY=

# 1 = mock mode: SAM and the reasoning model are stand-ins, no paid call.
# 0 = REAL mode: paid calls through the Meta Model API. Needs META_API_KEY.
SEWTRACE_MOCK=1

# REAL mode only: `sewtrace serve` refuses to start without a password, because every run spends money.
# The page asks for HTTP Basic auth; any username works, the password is this value.
SEWTRACE_WEB_PASSWORD=

# 1 = replay from the cache only and make no model call (demo bundles use this).
# SEWTRACE_OFFLINE=1

# Where cached model answers are read and written. Default: cache/ in the repository root.
# SEWTRACE_CACHE_DIR=

# The reasoning model, the API base URL, prices and limits are in sewtrace/config.toml.
